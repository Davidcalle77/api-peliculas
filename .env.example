# Copia este archivo como ".env" y cambia los valores por los de tu SQL Server
PORT=3000
DB_HOST=localhost
DB_PORT=1433
DB_NAME=peliculas_db
DB_USER=sa
DB_PASS=TuClaveAqui

# Solo si usas una instancia con nombre (ej. SQLEXPRESS), quita el "#" de la linea de abajo.
# En ese caso el puerto se ignora.
# DB_INSTANCE=SQLEXPRESS
